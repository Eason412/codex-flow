{
  "name": "parallel-modules",
  "why": "名称整理和区间计算互不调用，各自的实现与测试归一个任务，写入范围不重叠。",
  "phases": [{
    "title": "修复名称整理与区间计算",
    "tasks": [
      {
        "label": "名称整理",
        "model": "gpt-6.1-sol",
        "effort": "high",
        "pick": "default",
        "schema": "report",
        "promptFile": "prompts/fix-names.md",
        "writes": ["packages/names/index.mjs", "packages/names/index.test.mjs"],
        "checks": ["node --test packages/names/index.test.mjs"]
      },
      {
        "label": "区间计算",
        "model": "gpt-6.1-sol",
        "effort": "high",
        "pick": "default",
        "schema": "report",
        "promptFile": "prompts/fix-ranges.md",
        "writes": ["packages/ranges/index.mjs", "packages/ranges/index.test.mjs"],
        "checks": ["node --test packages/ranges/index.test.mjs"]
      }
    ]
  }]
}
